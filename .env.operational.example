APP_MODE=operational
DATABASE_URL=postgresql://jewel:replace-me@127.0.0.1:5432/jewel_os
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
BETTER_AUTH_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000
PORT=4000
VITE_APP_MODE=operational
VITE_API_ORIGIN=http://127.0.0.1:4000

# Optional recovery configuration (private real files, never commit keys)
# BACKUP_KEY_FILE=/etc/jewel-os/backup-key
# BACKUP_DIRECTORY=/var/backups/jewel-os

# Optional comma-separated IP/CIDR allowlist of actual reverse proxies. Empty = no proxy trust.
# Configure only after restricting direct backend access and verifying proxy header handling.
TRUST_PROXY=
