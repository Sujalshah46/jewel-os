# Jewellery OS frontend — data source switch (Phase 3 strangler)

# Local mode (default): all state in browser localStorage, exactly as before.
VITE_DATA_SOURCE=local

# API mode: talk to the Jewellery OS backend (~/workspace/jewelry-os-server).
# The app shows a login screen and syncs rates, customers, stock and invoices
# with the server. Requires the backend's CORS_ORIGINS to include this app's origin.
# VITE_DATA_SOURCE=api
# VITE_API_URL=https://your-backend.up.railway.app
