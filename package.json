{
  "name": "jewellery-os",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --mode demo",
    "dev:operational": "vite --mode operational",
    "build": "vite build --mode demo",
    "build:operational": "vite build --mode operational",
    "preview": "vite preview",
    "server:operational": "node --env-file=.env.operational server/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.operational ./node_modules/drizzle-kit/bin.cjs migrate",
    "operator:provision": "node --env-file=.env.operational scripts/provision-operator.js",
    "test:operational": "node scripts/prepare-operational-tests.js && node --test tests/operational-api.test.js tests/config-mode.test.js",
    "test": "node audit/calculation-tests.js && node audit/verify-fixes.js && node audit/admin-panel-tests.js && node audit/engineering-audit-tests.js && node --test tests/standalone-remediations.test.js tests/feature-gates.test.js tests/report-api.test.js tests/backup.test.js",
    "test:all": "npm test && npm run test:operational"
  },
  "dependencies": {
    "better-auth": "^1.7.7",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "express": "^5.2.1",
    "lucide-react": "^0.475.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.4.4"
  },
  "overrides": {
    "path-to-regexp": "^8.4.0",
    "esbuild": "^0.25.10"
  }
}
