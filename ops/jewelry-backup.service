[Unit]
Description=Encrypted Jewelry OS PostgreSQL backup
# Configure OnFailure for your monitoring agent before production use.

[Service]
Type=oneshot
User=jewelry
WorkingDirectory=/srv/jewel-os
ExecStart=/usr/bin/node --env-file=/etc/jewel-os/backup.env scripts/backup-job.js
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/backups/jewel-os
TimeoutStartSec=30min
